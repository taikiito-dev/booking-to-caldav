# Read-only IMAP access to the mailbox that receives the confirmations.
# Use a provider app password scoped to read-only where that is offered.
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USERNAME=you@example.com
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# CalDAV collection the events are written into. Must end in the collection
# itself, not the principal — e.g. https://dav.example.com/you/personal
CALDAV_URL=https://dav.example.com/you/personal
CALDAV_USERNAME=you
CALDAV_PASSWORD=
