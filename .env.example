# Read-only IMAP access to the mailbox that receives the confirmations.
# Use a provider app password scoped to read-only where that is offered.
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USERNAME=you@example.com
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# CalDAV collections. Each must end in the collection itself, not the
# principal — e.g. https://dav.example.com/you/personal
#
# CALDAV_URL alone puts everything in one place. The two optional variables
# below route by kind instead: travel takes you away from home and may be
# worth a shared household calendar, local happens where you live and
# normally does not need to be shared.
CALDAV_URL=https://dav.example.com/you/personal
#CALDAV_URL_TRAVEL=https://dav.example.com/you/household
#CALDAV_URL_LOCAL=https://dav.example.com/you/personal
CALDAV_USERNAME=you
CALDAV_PASSWORD=
